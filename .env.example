# ── Dashboard node endpoints ────────────────────────────────────────────
# Copy to .env (or .env.local, which is git-ignored) and adjust to your
# bench. These are the WebSocket ports of the superlexicon nodes — the
# ones serving the "stats" and "newHeads" subscriptions.
#
# Committed defaults live in .env; .env.local overrides without touching
# git state. Vite inlines these at dev/build time (VITE_ prefix required),
# so restart `npm run dev` (or rebuild) after changing them.

VITE_NODE1_WS=ws://192.168.50.91:8546
VITE_NODE2_WS=ws://192.168.50.92:8556
VITE_NODE3_WS=ws://192.168.50.4:8566

# Message testor (the messaging-app relay). Runs on the workstation:
#   cargo run --release --bin message-testor
VITE_TESTOR_WS=ws://192.168.50.91:8575
